# PondGuard runs fully locally. No cloud API keys are needed or used.
# Copy to .env and edit. Never commit .env.
# Relative paths below are resolved against this pondguard/ folder.

# LLM runtime: mock (default; offline, used by tests and CI) | lmstudio | ollama (optional fallback)
LLM_PROVIDER=mock

# LM Studio OpenAI-compatible server (start with: lms server start --port 1234)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Model keys exactly as shown by `lms ls`. All SLMs: <= 8B params, GGUF Q4_K_M.
# The judge must be a different model from the agent (ideally another family).
LMSTUDIO_AGENT_MODEL=meta-llama-3.1-8b-instruct   # chosen in the 25 Oct smoke test (docs/compute_budget.md)
LMSTUDIO_JUDGE_MODEL=qwen2.5-7b-instruct          # different family from the agent

# Optional fallback for teammates without LM Studio
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_AGENT_MODEL=
OLLAMA_JUDGE_MODEL=

# Tracing: phoenix (local Arize Phoenix UI) | jsonl (JSONL only). JSONL is always written.
TRACING=jsonl
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Local caches, kept inside "AI team project" but outside this git repo
HF_HOME=../cache/huggingface         # bge-small embedding model downloads here
PHOENIX_WORKING_DIR=../cache/phoenix # Phoenix trace database

PONDGUARD_VARIANT=B              # A = single-pass RAG, B = agentic RAG
PONDGUARD_INJECT_FAULT=none      # none | uncited_step (critic-revise demo; always labelled)
DATA_DIR=./data
